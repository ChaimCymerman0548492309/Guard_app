{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_SIMULATOR": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_DEV_SIMULATOR": "false",
        "EXPO_PUBLIC_API_URL": "https://guard-app-pe2n.onrender.com"
      },
      "android": {
        "buildType": "apk"
      },
      "corepack": true
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_DEV_SIMULATOR": "false"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
