# ── API Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL (optional — API falls back to simulator without DB)
DATABASE_URL=postgresql://guardian:guardian@localhost:5432/guardian

# Use simulated data only when DEV_SIMULATOR=true (tests/legacy lab). Default: real DB only.
DEV_SIMULATOR=false

# ── Security ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@guardian.local
ADMIN_PASSWORD=admin123

# ── Mobile (Expo) ───────────────────────────────────────
# true = demo mode with simulated events (no VPN needed)
# false = real Android VPN monitoring (requires dev build)
EXPO_PUBLIC_DEV_SIMULATOR=false

# Optional API sync URL for mobile → cloud backup (must be HTTPS when phone is off local Wi‑Fi)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Web dashboard production build — leave empty when nginx proxies /api on same host
# VITE_API_URL=https://api.yourdomain.com

# Privacy policy URL (shown in Settings → Privacy Policy)
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://guardian.app/privacy

# ── Docker Compose ──────────────────────────────────────
# Used by docker-compose.yml — override if needed
# POSTGRES_USER=guardian
# POSTGRES_PASSWORD=guardian
# POSTGRES_DB=guardian

# ── Cloud deploy (docker-compose.cloud.yml) ─────────────
# JWT_SECRET=required-long-random
# ADMIN_PASSWORD=required-strong-password
# POSTGRES_PASSWORD=change-from-default
# WEB_PORT=8080
# RUN_DB_SEED=true
# DEV_SIMULATOR=false
